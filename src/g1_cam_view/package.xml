<?xml version="1.0"?>
<package format="3">
  <name>g1_cam_view</name>
  <version>0.1.0</version>
  <description>Camera-only ROS 2 stack for the Unitree G1: RealSense D435 and two Logitech USB cameras.</description>
  <maintainer email="maintainer@example.com">G1 camera view team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>usb_cam</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
